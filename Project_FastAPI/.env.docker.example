# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOU_PG_PASSWORD
POSTGRES_DB=notes_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async URL
DATABASE_URL=postgresql+asyncpg://postgres:YOU_PG_PASSWORD@db:5432/notes_db

# Security
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30